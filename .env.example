PROJECT_NAME="Agentic Order Management System"
PROJECT_VERSION="0.1.0"
PROJECT_DESCRIPTION="Agentic Order Management System using FastAPI, LangChain, Qdrant Hybrid Search, SQLite."

ENVIRONMENT="DEVELOPMENT"
LOG_DIR="logs"

DATABASE_URL="sqlite:///./data/db.sqlite"

LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.6-flash"
GOOGLE_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="order_management_specs"

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=43200

BACKEND_API_URL="http://localhost:8000"

SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SENDER_EMAIL="noreply@ag-oms.com"
